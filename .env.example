# ---------------------------------------------------------------------------
# OPTIONAL. Everything below can be set from the admin console (Settings page),
# where secrets are stored encrypted, so you never need to edit this file.
# Values saved in the console override this file. Only DB_PATH (and optionally
# TRADEAI_MASTER_KEY, a base64 32-byte key) must come from the environment.
# ---------------------------------------------------------------------------

# Runtime
HOST=127.0.0.1                 # bind the admin console to localhost; put a TLS reverse proxy in front
PORT=8080
DB_PATH=data/tradeai.db
MODE=paper                     # paper | live
LIVE_TRADING_ENABLED=false     # second key required for live orders
DATA_SOURCE=synthetic          # synthetic | upstox
CRYPTO_ENABLED=false

# Admin console (generate with: npm run admin:passwd -- "<password>")
ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
SESSION_TTL_HOURS=12

# Upstox (Algo Trading App)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://your-host/api/upstox/callback
# UPSTOX_ACCESS_TOKEN=         # optional: normally obtained via the daily login in the console
UPSTOX_ALGO_NAME=              # must exactly match the Algo Name on the Upstox app (sent as X-Algo-Name)
UPSTOX_SANDBOX=false

# Static-IP egress (SEBI/NSE retail-algo framework)
STATIC_IP_PRIMARY=
STATIC_IP_SECONDARY=
EGRESS_IP_CHECK_URL=https://api.ipify.org

# Order-rate guard (exchange threshold is 10 OPS; stay well under)
OPS_HARD_LIMIT=6
OPS_ALERT_AT=5
UPSTOX_REQ_PER_SEC=25
UPSTOX_REQ_PER_MIN=250
UPSTOX_REQ_PER_30MIN=1000
UPSTOX_MULTI_ORDER_MAX=10

# Delta Exchange India (withdrawal-disabled, IP-whitelisted keys)
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org   # production: https://api.india.delta.exchange
DELTA_DEADMAN_MS=60000

# Research agent (OpenAI). Cost cascade: rules decide obvious cases with no LLM call;
# the cheap model triages everything else; the strong model judges only actionable
# (REACT / PROTECT) or unsure calls and must agree with the cheap model (2-of-3 tie-break).
OPENAI_API_KEY=
LLM_FAST_MODEL=gpt-6-luna      # $0.10 in / $0.50 out per 1M tokens
LLM_DEEP_MODEL=gpt-6-sol       # $2 in / $10 out per 1M tokens (gpt-6-astra: strongest, 5x the price)
LLM_FAST_EFFORT=low
LLM_DEEP_EFFORT=medium
LLM_UNSURE_LOW=0.35
LLM_UNSURE_HIGH=0.75
LLM_MAX_USD_PER_DAY=5
LLM_FAST_TIMEOUT_MS=20000
LLM_DEEP_TIMEOUT_MS=180000
LLM_MAX_CALLS_PER_DAY=400
LLM_MAX_DEEP_PER_HOUR=6
LLM_TRAINING_CUTOFF=2026-01-01

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
P0_WEBHOOK_URL=                # phone/SMS escalation endpoint for P0 events
WATCHDOG_URL=                  # heartbeat receiver on a separate host (optional push mode)

# Capital
CAPITAL_INR=1000000
