{
  "name": "tradeai",
  "version": "0.1.0",
  "private": true,
  "description": "TradeAI: event-driven Indian equities/F&O + Delta India crypto trading system with market-wide anomaly scanner, research agent, validation stack and admin console",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "backtest": "node --disable-warning=ExperimentalWarning src/cli/backtest.ts",
    "admin:passwd": "node --disable-warning=ExperimentalWarning src/cli/passwd.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "eval:research": "node --disable-warning=ExperimentalWarning src/research/evals/runEval.ts",
    "train:meta": "node --disable-warning=ExperimentalWarning src/ml/trainMeta.ts",
    "watchdog": "node --disable-warning=ExperimentalWarning src/ops/watchdog.ts",
    "backup": "node --disable-warning=ExperimentalWarning src/cli/backup.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandandadhekar-cloud/ai-trader.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "protobufjs": "^8.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
